# Flask configuration
SECRET_KEY=change-this-to-a-very-long-random-secret-string
FLASK_ENV=production

# Database (SQLite)
DATABASE_PATH=instance/job_portal.db

# Upload limits (in megabytes)
MAX_CONTENT_LENGTH=10

# Optional SMTP configuration (leave blank to disable email sending)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Initial admin setup (used only on first database initialization)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=JobNest@2024!
ADMIN_NAME=Site Administrator
